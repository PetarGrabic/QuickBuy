# Supabase project that backs the QuickBuy product catalogue.
# Project dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sanity project that backs QuickBuy editorial content (Studio at /studio).
# Project dashboard: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret between the Sanity webhook and /api/revalidate. Generate with:
#   node -e "console.log(crypto.randomUUID())"
SANITY_REVALIDATE_SECRET=your-webhook-secret
